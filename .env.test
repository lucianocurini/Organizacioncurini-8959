# .env.test de la RAÍZ del repo — sin secretos, seguro para commitear.
#
# Defensa adicional (no sustituye la guarda de
# packages/web/src/api/database/assert-safe-environment.ts): cuando
# NODE_ENV=test, Bun saltea .env.local por convención, así que sin este
# archivo `bun test` corrido desde la raíz caía en el .env de producción.
# Con este archivo, cae acá primero.
#
# Ruta relativa a la raíz del repo (confirmado: resuelve al mismo
# packages/web/dev.db que usan los tests locales).
DATABASE_URL=file:packages/web/dev.db
DATABASE_AUTH_TOKEN=local-test-dummy
