coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# local databases
*.db

# local database backups y snapshots de producción (nunca commitear —
# pueden contener datos reales de asegurados/pagos; ver incidente de
# database-safety). Reglas explícitas y redundantes a propósito: estos
# archivos no terminan en ".db", así que *.db no los cubre.
dev.db.backup*
*.db.backup*
*.db.backup-*
packages/web/dev.db.backup*
packages/web/backup-prod-*.json
packages/web/backup-test-*.json
packages/web/backup-*-prod-*.json
backups/
*.backup
*.backup.*
backup-*.json
*-backup-*.json

# local read-only audits (nunca commitear — puede contener datos de producción)
local-audits/

# dotenv environment variable files
.env
.env.test
.env.staging
.env.development.local
.env.test.local
.env.production.local
.env.local
.env*.local

# excepción: .env.test de la RAÍZ (sin secretos — solo fuerza file: local
# para que `bun test` corrido desde la raíz nunca resuelva a Turso, ver
# assert-safe-environment.ts). Los .env.test anidados (ej. packages/web/.env.test)
# siguen ignorados por la regla de arriba.
!/.env.test

# Local R2 backup test credentials (Fase 3B) — nunca commitear. No cae bajo
# el patrón .env*.local de arriba porque termina en "-local" (guion), no
# ".local" (punto) — regla explícita y redundante a propósito, mismo criterio
# que las reglas de backups de producción más arriba.
packages/web/.env.r2-local

# Credenciales de R2 + Turso producción para la primera prueba real de
# backup prod → R2 (Fase 3B/3C). Mismo motivo que la regla de arriba: no cae
# bajo ningún patrón .env* existente. Contiene credenciales reales — nunca
# commitear.
packages/web/.env.r2-prod

